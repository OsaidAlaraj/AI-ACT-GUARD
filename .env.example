# Copy to apps/web/.env.local. Never commit real keys.
# Prototype runs on invented test data only (requirements D7); plain API keys are fine.

# Model gateway (packages/gateway): provider = anthropic | openai | mistral
AAG_MODEL_PROVIDER=anthropic
AAG_MODEL_ID=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Database (Neon, EU Frankfurt). Tests use PGlite and need no URL.
DATABASE_URL=

# Expert sign-in (Better Auth), added by the auth ticket
BETTER_AUTH_SECRET=
